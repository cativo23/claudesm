{
  "name": "claudesm",
  "version": "2.1.0",
  "description": "Manage your Claude Code sessions with elegance",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/cativo23/claudesm#readme",
  "bugs": {
    "url": "https://github.com/cativo23/claudesm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cativo23/claudesm.git"
  },
  "bin": {
    "csm": "dist/csm.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/csm.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test $(find src \\( -name '*.test.ts' -o -name '*.test.tsx' \\))",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "env-paths": "^2.2.1",
    "execa": "^9.5.0",
    "ink": "^7.0.3",
    "picocolors": "^1.1.0",
    "react": "^19.2.0",
    "std-env": "^3.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
