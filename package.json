{
  "name": "claudesm",
  "version": "2.0.0",
  "description": "Manage your Claude Code sessions with elegance",
  "type": "module",
  "bin": {
    "csm": "./dist/csm.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/csm.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx/esm src",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "env-paths": "^2.2.1",
    "execa": "^9.5.0",
    "ink": "^7.0.3",
    "picocolors": "^1.1.0",
    "react": "^19.2.0",
    "std-env": "^3.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
